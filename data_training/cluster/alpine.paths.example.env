# Copy this file to alpine.paths.env and edit values for your account.
# Do not put passwords, tokens, or private keys in this file.

export EWALD_CLUSTER_HOST="${EWALD_CLUSTER_HOST:-alpine-login.rc.colorado.edu}"
export EWALD_CLUSTER_USER="${EWALD_CLUSTER_USER:-$USER}"

# Slurm allocation/account settings. CURC documents allocations as Slurm
# accounts; set EWALD_ALPINE_ACCOUNT to the exact account string assigned to
# your Ascent allocation.
export EWALD_ALPINE_ACCOUNT="${EWALD_ALPINE_ACCOUNT:-}"
export EWALD_ALPINE_PARTITION="${EWALD_ALPINE_PARTITION:-amilan}"
export EWALD_ALPINE_QOS="${EWALD_ALPINE_QOS:-normal}"

# Local source checkout. The staging script defaults this to the current working
# directory if it is not set.
export EWALD_LOCAL_REPO="${EWALD_LOCAL_REPO:-$PWD}"

# Alpine-style project and scratch examples. Adjust these to match the active
# allocation and cluster policy.
export EWALD_RUNTIME_DIR="${EWALD_RUNTIME_DIR:-/projects/$USER/ewald-training/runtime}"
export EWALD_SCRATCH_DIR="${EWALD_SCRATCH_DIR:-/scratch/alpine/$USER/ewald-training}"

# Optional local paths to stage. Leave empty until the data_training package owns
# these conventions.
export EWALD_LOCAL_CATALOG_DIR="${EWALD_LOCAL_CATALOG_DIR:-}"
export EWALD_LOCAL_PLAN_FILE="${EWALD_LOCAL_PLAN_FILE:-data_training/cluster/templates/generation_plan.example.jsonl}"

# Runtime plan location used by Slurm jobs after staging.
export EWALD_PLAN_FILE="${EWALD_PLAN_FILE:-$EWALD_RUNTIME_DIR/plans/generation_plan.jsonl}"
export EWALD_TRAINING_MANIFEST="${EWALD_TRAINING_MANIFEST:-$EWALD_SCRATCH_DIR/manifests/training-manifest.jsonl}"

# Environment setup. Edit for the module stack installed on the cluster.
export EWALD_MODULES="${EWALD_MODULES:-anaconda}"
export EWALD_CONDA_ENV="${EWALD_CONDA_ENV:-ewald-training}"
export EWALD_CONDA_SH="${EWALD_CONDA_SH:-$HOME/miniconda3/etc/profile.d/conda.sh}"
export EWALD_BOOTSTRAP_CREATE_ENV="${EWALD_BOOTSTRAP_CREATE_ENV:-0}"
export EWALD_REMOTE_SESSION_NAME="${EWALD_REMOTE_SESSION_NAME:-ewald-training}"

# Command hooks. These are intentionally overridable while the data_training
# Python package and CLI entry points are being developed.
export EWALD_GENERATE_CMD="${EWALD_GENERATE_CMD:-python data_training/scripts/generate_dataset.py}"
export EWALD_TRAIN_CMD="${EWALD_TRAIN_CMD:-python -m ewald.data_training.train_structure_ranker}"
export EWALD_VALIDATE_CMD="${EWALD_VALIDATE_CMD:-python -m ewald.data_training.validate_indexing_pipeline}"

# Local sync target for compact manifests and metrics.
export EWALD_LOCAL_SYNC_DIR="${EWALD_LOCAL_SYNC_DIR:-data_training/cluster/_synced_outputs}"

# Ascent pipeline defaults. Keep the HybriD3 limit small until the staged
# runtime is verified, then set EWALD_HYBRID3_LIMIT=0 for a full crawl.
export EWALD_HYBRID3_MODE="${EWALD_HYBRID3_MODE:-live}"
export EWALD_HYBRID3_LIMIT="${EWALD_HYBRID3_LIMIT:-25}"
export EWALD_HYBRID3_PAGE_SIZE="${EWALD_HYBRID3_PAGE_SIZE:-200}"
export EWALD_HYBRID3_TIMEOUT="${EWALD_HYBRID3_TIMEOUT:-60}"
export EWALD_SIM_PLAN="${EWALD_SIM_PLAN:-data_training/configs/simulation_alpine_fibril_training.example.yaml}"
export EWALD_ARTIFACT_CONFIG="${EWALD_ARTIFACT_CONFIG:-data_training/configs/artifacts.example.yaml}"
export EWALD_ARTIFACT_VARIANTS="${EWALD_ARTIFACT_VARIANTS:-2}"
export EWALD_FEEDBACK_TOP_K="${EWALD_FEEDBACK_TOP_K:-5}"
export EWALD_FEEDBACK_MAX_SAMPLES="${EWALD_FEEDBACK_MAX_SAMPLES:-}"

# Per-stage resources. Command-line sbatch options from the submitter override
# the generic #SBATCH defaults in the wrapper script.
export EWALD_FETCH_TIME="${EWALD_FETCH_TIME:-04:00:00}"
export EWALD_FETCH_CPUS="${EWALD_FETCH_CPUS:-4}"
export EWALD_FETCH_MEM="${EWALD_FETCH_MEM:-16G}"
export EWALD_SIM_TIME="${EWALD_SIM_TIME:-24:00:00}"
export EWALD_SIM_CPUS="${EWALD_SIM_CPUS:-16}"
export EWALD_SIM_MEM="${EWALD_SIM_MEM:-64G}"
export EWALD_ART_TIME="${EWALD_ART_TIME:-08:00:00}"
export EWALD_ART_CPUS="${EWALD_ART_CPUS:-8}"
export EWALD_ART_MEM="${EWALD_ART_MEM:-32G}"
export EWALD_TRAIN_TIME="${EWALD_TRAIN_TIME:-24:00:00}"
export EWALD_TRAIN_CPUS="${EWALD_TRAIN_CPUS:-16}"
export EWALD_TRAIN_MEM="${EWALD_TRAIN_MEM:-96G}"
export EWALD_TRAIN_GRES="${EWALD_TRAIN_GRES:-}"
export EWALD_FEEDBACK_TIME="${EWALD_FEEDBACK_TIME:-04:00:00}"
export EWALD_FEEDBACK_CPUS="${EWALD_FEEDBACK_CPUS:-8}"
export EWALD_FEEDBACK_MEM="${EWALD_FEEDBACK_MEM:-32G}"
